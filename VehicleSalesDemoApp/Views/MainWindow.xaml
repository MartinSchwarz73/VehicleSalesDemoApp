<Window x:Class="VehicleSalesDemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VehicleSalesDemoApp" xmlns:viewmodel="clr-namespace:VehicleSalesDemoApp.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodel:MainViewModel}"
        mc:Ignorable="d"
        Title="Vehicle Sales Demo App" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        MinWidth="500"
        MinHeight="450"
        Background="#FAFAFA">

    <Window.Resources>

        <Style x:Key="HeaderCenter" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="HeaderLeft" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

    </Window.Resources>


    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Padding="10"
            Margin="0 0 0 10"
            Background="#13F3F3"
            CornerRadius="6">

            <StackPanel Orientation="Horizontal">
                <Button Content="Load XML" Click="Load_Click"
                    Width="120"
                    Height="35"
                    Margin="0 0 10 0"/>

                <Button Content="Calculate" Click="Calc_Click"
                    Width="120"
                    Height="35"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Sales Data"
           FontSize="18"
           FontWeight="SemiBold"
           Margin="0 0 0 5"/>

        <DataGrid 
            Grid.Row="2" 
            ItemsSource="{Binding Sales}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            GridLinesVisibility="None"
            AlternatingRowBackground="#F5F5F5"
            RowBackground="White"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#E0E0E0"
            VerticalGridLinesBrush="#E0E0E0"
            Margin="0 0 0 10"
            Padding="0,0,0,15"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Název modelu"
                                    Binding="{Binding Model}" 
                                    Width="2*"
                                    HeaderStyle="{StaticResource HeaderLeft}" />

                <DataGridTextColumn Header="Datum prodeje"
                                    Binding="{Binding SaleDate, StringFormat={}{0:d}, ConverterCulture=cs-CZ}"
                                    Width="*"
                                    HeaderStyle="{StaticResource HeaderCenter}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="Cena (Kč)"
                                    Binding="{Binding Price, StringFormat=N0, ConverterCulture=cs-CZ}" 
                                    Width="*"
                                    HeaderStyle="{StaticResource HeaderCenter}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="DPH (%)"
                                    Binding="{Binding VAT}" 
                                    Width="Auto"
                                    MinWidth="40"
                                    HeaderStyle="{StaticResource HeaderCenter}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="3"
                BorderBrush="Black"
                BorderThickness="1"
                Margin="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Background="#EAEAEA">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MODEL -->
                    <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Název modelu"
                       FontWeight="SemiBold"
                       Padding="5"/>

                    <!-- SUBHEADERS -->
                    <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Cena bez DPH"
                       FontWeight="SemiBold"
                       Padding="5"/>

                    <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="Cena s DPH"
                       FontWeight="SemiBold"
                       Padding="5"/>

                </Grid>
                <ScrollViewer   Grid.Row="1" 
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                MaxHeight="300">

                    <!-- DATA -->
                    <ItemsControl ItemsSource="{Binding Summary}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border BorderBrush="#D0D0D0"
                                        BorderThickness="0,0,0,1">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- MODEL -->
                                        <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Model}"
                                       Padding="5"/>

                                        <!-- VALUES -->
                                        <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Total, StringFormat=N2, ConverterCulture=cs-CZ}"
                                       Padding="5"/>

                                        <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding TotalWithVAT, StringFormat=N2, ConverterCulture=cs-CZ}"
                                       Padding="5"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>



    </Grid>
</Window>
